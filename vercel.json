{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/kalkulator-czyste-powietrze",
      "destination": "/pompy-ciepla-wroclaw",
      "permanent": true
    },
    {
      "source": "/kalkulator-czyste-powietrze/:path*",
      "destination": "/pompy-ciepla-wroclaw",
      "permanent": true
    },
    {
      "source": "/wiedza",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/wiedza/jak-dziala-klimatyzator-prosto-wyjasnione",
      "destination": "/blog/jak-zbudowany-jest-klimatyzator",
      "permanent": true
    },
    {
      "source": "/blog/jak-dziala-klimatyzator",
      "destination": "/blog/jak-zbudowany-jest-klimatyzator",
      "permanent": true
    },
    {
      "source": "/wiedza/:path*",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/chlodnictwo-:path*",
      "destination": "/montaz-klimatyzacji-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/czyszczenie-mechaniczne-wentylacji",
      "destination": "/czyszczenie-kanalow-wentylacji-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/czyszczenie-kanalow-wentylacji",
      "destination": "/czyszczenie-kanalow-wentylacji-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/serwis-klimatyzacji",
      "destination": "/serwis-klimatyzacji-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/montaz-klimatyzacji",
      "destination": "/montaz-klimatyzacji-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/wentylacja-mechaniczna",
      "destination": "/wentylacja-mechaniczna-rekuperacja-wroclaw",
      "permanent": true
    },
    {
      "source": "/uslugi/pompy-ciepla",
      "destination": "/pompy-ciepla-wroclaw",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/montaz-klimatyzacji-wroclaw/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/wentylacja-mechaniczna-rekuperacja-wroclaw/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "nurtex-www.vercel.app"
        }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
